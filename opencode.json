{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (Optio)",
      "options": {
        "baseURL": "{env:OPENCODE_BASE_URL}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "coding-router": {
          "name": "Coding Router (complexity tiers)"
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow",
    "bash": "allow"
  }
}

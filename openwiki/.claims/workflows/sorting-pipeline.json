    },
    {
      "id": "claim_f310896408834b9fb813e5b6adefd9a7",
      "statement": "The RelativePath provenance tag is computed from the source-relative directory path os.path.relpath(os.path.dirname(file_path), basepath) and appended to the copy's EXIF UserComment as b\"\\nRelativePath:\" + relative_path, only for .jpg/.jpeg files; other supported formats are copied and dated but never tagged.",

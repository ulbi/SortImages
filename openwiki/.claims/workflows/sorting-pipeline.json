  "claims": [
    {
      "id": "claim_07c74fed31604483925db8a4b926d1ad",
      "statement": "sort_images validates that threads is between 1 and 100 (raising ValueError otherwise), creates output_path with os.makedirs if missing, and discovers files by walking basepath recursively with os.walk, appending every file to files_to_process without any format filtering.",
      "evidence": [
        {
          "resource": "repo://sortinfolder.py#L223-L249",
          "version": "repo-lines-v1:sha256:2a0f43fb098a8e41fd226550904d7899145f759945b31410201bfaea0201d7fe:"
        },
        {
          "resource": "repo://sortinfolder.py#L255-L257",
          "version": "repo-lines-v1:sha256:1414ed5707603da8968f8d728a5ba126ecbcdf40c9b9cd8a53fbb7d9c5803367:"
        }
      ]
    },
    {
      "id": "claim_8f2ce452d36241299db9b45cfe468506",
      "statement": "Format filtering happens per-file inside process_image, not during discovery, so files with unsupported extensions are submitted, their process_image call returns immediately after a debug log, and they are counted as successes — a nonexistent basepath likewise yields an empty, exit-0 run.",
      "evidence": [
        {
          "resource": "repo://sortinfolder.py#L167-L170",
          "version": "repo-lines-v1:sha256:6e8bbe0c6569991bb995633f042b7cfedd51f1d713bce4e9e7eec3e75e1146b9:"
        },
        {

          "version": "repo-lines-v1:sha256:2a0f43fb098a8e41fd226550904d7899145f759945b31410201bfaea0201d7fe:"
        }
      ]
    },
    {
      "id": "claim_a91f7a912b2945f0b9396c9706b709d9",
      "statement": "sort_images submits one executor.submit(process_image, file_path, basepath, output_path, dry_run) future per discovered file into a concurrent.futures.ThreadPoolExecutor(max_workers=threads), keeping a dict keyed by future to file_path so the completion loop can attribute outcomes; the default is 30 threads and each worker is independent with no shared state beyond the filesystem.",
      "evidence": [
        {
          "resource": "repo://sortinfolder.py#L255-L257",
          "version": "repo-lines-v1:sha256:1414ed5707603da8968f8d728a5ba126ecbcdf40c9b9cd8a53fbb7d9c5803367:"
        }
      ]
    },
    {
      "id": "claim_e027f7b3fcac4eb987a74aa78fa6f5d9",
      "statement": "process_image runs five steps in fixed order: lowercased extension check against SUPPORTED_FORMATS (returning before any work if unsupported), get_date_taken on the source file, computing the destination folder output/YYYY/MM/DD via date_taken.strftime, creating the date folder with os.makedirs (unless dry-run), and resolving the target filename.",
      "evidence": [
        {
          "resource": "repo://sortinfolder.py#L167-L170",
          "version": "repo-lines-v1:sha256:6e8bbe0c6569991bb995633f042b7cfedd51f1d713bce4e9e7eec3e75e1146b9:"
        },

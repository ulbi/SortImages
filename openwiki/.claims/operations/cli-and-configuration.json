    {
      "id": "claim_4baec3552bcc4948821797b5b4d242be",
      "statement": "sort_images submits every regular file discovered under basepath regardless of extension, so unsupported formats return normally and are counted as successes; the Processed and Succeeded totals therefore describe submitted files rather than the number of generated output images.",

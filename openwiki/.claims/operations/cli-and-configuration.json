    {
      "id": "claim_30cd855502ec4bf89ac83c095f10f669",
      "statement": "sort_images submits one process_image future per file found by os.walk(basepath) to a ThreadPoolExecutor(max_workers=threads), counts successes/failures as futures complete via as_completed, and returns the tuple (success_count, failure_count, errors_list).",
      "evidence": [

    {
      "id": "claim_fac2fee4c70049ea9239814b1ddab5f4",
      "statement": "Argparse owns command-line shape errors: a missing required positional path, an unknown option, or a non-integer --threads value is rejected before the processing body runs and produces argparse's standard usage-error exit status 2.",

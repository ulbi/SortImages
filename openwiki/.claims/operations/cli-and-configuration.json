    {
      "id": "claim_c087983b592449d1bae57fa43a0da6ba",
      "statement": "main() validates --log immediately after parsing: the value is upper-cased and looked up via getattr(logging, args.log.upper(), None); a non-int result raises TypeError(\"Invalid log level: {args.log}\") before logging is configured or any file is processed. Default is \"INFO\". Because the lookup uses an unqualified attribute name, standard names such as DEBUG, INFO, WARNING, WARN, ERROR, FATAL, CRITICAL, and NOTSET are accepted, while a dotted spelling such as logging.DEBUG is not.",
      "evidence": [
        {
          "resource": "repo://README.md#L32-L38",
          "version": "repo-lines-v1:sha256:96a68031d0369f53238e8ba95f36a02dac2f30a07d47d82c7233a60b257d69d6:"

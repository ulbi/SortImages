    {
      "id": "claim_79beb99a839d45b8a2c813a6017ffaad",
      "statement": "main() exits with sys.exit(1) only when sort_images reports failure_count > 0; a fully successful run falls through and exits 0. test_cli_exit_code_end_to_end asserts exit code 1 for a run containing a corrupted file and exit code 0 for a run of valid files only.",
      "evidence": [
        {
          "resource": "repo://sortinfolder.py#L311-L314",

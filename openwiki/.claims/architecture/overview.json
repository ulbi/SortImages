    {
      "id": "claim_ed78bc4e156e44ffb16a2f4242a2525b",
      "statement": "get_date_taken parses EXIF DateTimeOriginal via exifread with format %Y:%m:%d %H:%M:%S to build the %Y/%m/%d folder structure; on OSError, KeyError, or ValueError (missing/unreadable/malformed tag) it logs a warning and falls back to the file's creation time via datetime.fromtimestamp(os.path.getctime(path)).",

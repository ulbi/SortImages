    {
      "id": "claim_33a04048fe8a432e90fd2be69fbfae32",
      "statement": "The application holds no persistent state beyond filesystem outputs: shutil.copy2 initially preserves source file metadata, while rotation and tagging operate on the destination copy, so the source inputs are not mutated or deleted. The resulting output tree is the durable result of a run, and there is no database, cache, runtime configuration file, or persistent in-memory index.",
      "evidence": [
        {
          "resource": "repo://sortinfolder.py#L156-L221",

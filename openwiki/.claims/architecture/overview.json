    {
      "id": "claim_9675f2ea371840c8aa1324db35a9c51a",
      "statement": "process_image applies SUPPORTED_FORMATS = {'.jpg', '.jpeg', '.png', '.heic', '.tiff', '.tif', '.bmp', '.webp'} as its first gate: the lowercased extension must be in this set or the file is skipped before any date lookup, copying, or EXIF work. The constant is an admission boundary into the shared pipeline, not a guarantee of equivalent decoding, orientation, or tagging support for every listed extension.",
      "evidence": [

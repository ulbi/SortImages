    },
    {
      "id": "claim_bfa1661b2b0b4bc3b74995cb5229f369",
      "statement": "Per-file processing in process_image() extracts the capture date (EXIF DateTimeOriginal with file-creation-time fallback), creates a year/month/day subfolder, resolves filename collisions with _N suffixes, copies the file with shutil.copy2, rotates it per its EXIF orientation tag, and for JPEG files appends a `RelativePath:` UserComment tag via piexif; with dry_run=True the same decisions are only logged.",
      "evidence": [
        {
          "resource": "repo://sortinfolder.py#L152-L227",
          "version": "repo-lines-v1:sha256:92ebd864541b3c3da9878492842cf2996e26d29b7d2e071138ebe967e1ce1f6c:"
        }
      ]
    },
    {
      "id": "claim_81cb488f65f640c19f093d17f47c476f",
      "statement": "The supported image formats are .jpg, .jpeg, .png, .heic, .tiff, .tif, .bmp, and .webp, defined in SUPPORTED_FORMATS and enforced in process_image(), which skips files with other extensions.",

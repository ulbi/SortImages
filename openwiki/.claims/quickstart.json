    {
      "id": "claim_c9de560fe2704bfdbe8dd2657a6087eb",
      "statement": "The tool's CLI is `python sortinfolder.py [basepath] [output_path] [--log LEVEL] [--threads N] [--dry-run]`: main() defines positional basepath and output_path plus --log (default INFO), --threads (default 30, range 1-100), and a --dry-run store_true flag; the process exits with code 1 when any file failed to process.",
      "evidence": [
        {
